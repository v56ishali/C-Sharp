using System;

class Program
{
    // Declare delegate
    public delegate void TrafficSignal();

    // Methods
    public static void Yellow()
    {
        Console.WriteLine("Yellow Light Signal To Get Ready");
    }

    public static void Green()
    {
        Console.WriteLine("Green Light Signal To Go");
    }

    public static void Red()
    {
        Console.WriteLine("Red Light Signal To Stop");
    }

    static void Main()
    {
        // Delegate instances
        TrafficSignal signal;

        signal = Yellow;
        signal();

        signal = Green;
        signal();

        signal = Red;
        signal();

        // Multicast delegate
        TrafficSignal signals = Yellow;
        signals += Green;
        signals += Red;

        Console.WriteLine("\nMulticast Delegate:");
        signals();
    }
}
